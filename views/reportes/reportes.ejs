<h2 class="mb-4">Reportes de Consolidación</h2>

<script>
    // Semilla desde servidor: última consolidación generada en /consolidacion (si existe)
    window.consolidacionDatosUltimos = <%- JSON.stringify(ultimaConsolidacion ? ultimaConsolidacion.datos : null) %> || null;
    window.consolidacionUltimaMeta = <%- JSON.stringify(ultimaConsolidacion ? {
        desde: ultimaConsolidacion.desde,
        hasta: ultimaConsolidacion.hasta,
        empresasCount: (ultimaConsolidacion.empresas || []).length
    } : null) %> || null;
</script>

<!-- Visor de consolidación (solo lectura + exportación) -->
<div id="consolidacion-reportes-root">
    <!-- Resumen del período y empresas -->
    <div class="card mb-4">
        <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center">
            <div>
                <h6 class="text-muted mb-1">Período consolidado</h6>
                <div>
                    <span id="rep-periodo-texto">Cargando...</span>
                </div>
            </div>
            <div class="mt-3 mt-md-0">
                <span class="text-muted">Empresas incluidas: </span>
                <span class="fw-bold" id="rep-empresas-count">0</span>
            </div>
        </div>
    </div>

    <!-- Tabs con los mismos consolidados que en /consolidacion -->
    <ul class="nav nav-tabs mb-4" id="rep-formulariosTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="rep-tab-estado-resultados" data-bs-toggle="tab" data-bs-target="#rep-estado-resultados" type="button" role="tab">
                <i class="bi bi-graph-up-arrow me-2"></i>
                <span class="fw-bold">ESTADO DE RESULTADOS</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="rep-tab-balance-general" data-bs-toggle="tab" data-bs-target="#rep-balance-general" type="button" role="tab">
                <i class="bi bi-bank2 me-2"></i>
                <span class="fw-bold">BALANCE GENERAL</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="rep-tab-flujo-operativo" data-bs-toggle="tab" data-bs-target="#rep-flujo-operativo" type="button" role="tab">
                <i class="bi bi-cash-coin me-2"></i>
                <span class="fw-bold">FLUJO OPERATIVO</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="rep-tab-flujo-corporativo" data-bs-toggle="tab" data-bs-target="#rep-flujo-corporativo" type="button" role="tab">
                <i class="bi bi-building2 me-2"></i>
                <span class="fw-bold">FLUJO CORPORATIVO</span>
            </button>
        </li>
    </ul>

    <div class="tab-content" id="rep-formulariosTabContent">
        <div class="tab-pane fade show active" id="rep-estado-resultados" role="tabpanel">
            <%- include('../consolidacion/consolidado-estado-resultados') %>
        </div>
        <div class="tab-pane fade" id="rep-balance-general" role="tabpanel">
            <%- include('../consolidacion/consolidado-balance-general') %>
        </div>
        <div class="tab-pane fade" id="rep-flujo-operativo" role="tabpanel">
            <%- include('../consolidacion/consolidado-flujo-operativo') %>
        </div>
        <div class="tab-pane fade" id="rep-flujo-corporativo" role="tabpanel">
            <%- include('../consolidacion/consolidado-flujo-corporativo') %>
        </div>
    </div>

    <!-- Acciones generales -->
    <div class="card mt-4">
        <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center">
            <div class="text-muted small mb-2 mb-md-0">
                Datos consolidados generados automáticamente (últimos 12 meses, todas las empresas activas).
            </div>
            <div class="btn-group">
                <button type="button" class="btn btn-outline-success" onclick="window.exportAllConsolidacion && window.exportAllConsolidacion()">
                    <i class="bi bi-file-excel me-2"></i> Exportar los 4 a Excel
                </button>
                <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
                    <i class="bi bi-printer me-2"></i> Imprimir
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Utilidades de consolidación (reutilizadas) -->
<script src="/js/consolidacion/utils/formatNumber.js"></script>
<script src="/js/consolidacion/apiService.js"></script>
<script src="/js/reportes/consolidacion-reportes.js"></script>
