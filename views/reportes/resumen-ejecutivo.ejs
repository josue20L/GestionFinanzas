<h2 class="mb-4">Resumen Ejecutivo</h2>

<!-- Selectores de Empresa y Período -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label for="empresa-select" class="form-label">Empresa</label>
                <select id="empresa-select" class="form-select">
                    <option value="">Seleccione una empresa</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="periodo-select" class="form-label">Período (YYYY-MM)</label>
                <input type="month" id="periodo-select" class="form-control" value="">
            </div>
            <div class="col-md-6">
                <button type="button" class="btn btn-primary" onclick="cargarResumenEjecutivo()">
                    <i class="bi bi-file-earmark-text me-2"></i> Generar Resumen
                </button>
                <button type="button" class="btn btn-outline-secondary ms-2" onclick="exportarPDF()">
                    <i class="bi bi-file-pdf me-2"></i> Exportar PDF
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Contenedor del Resumen (inicialmente oculto) -->
<div id="resumen-container" style="display: none;">
    <!-- Contexto del Reporte -->
    <div class="card mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">
                <i class="bi bi-info-circle me-2"></i>Información del Reporte
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <strong>Período:</strong> <span id="contexto-periodo">-</span>
                </div>
                <div class="col-md-3">
                    <strong>Empresa:</strong> <span id="contexto-empresa">-</span>
                </div>
                <div class="col-md-3">
                    <strong>Reporte:</strong> <span id="contexto-reporte">-</span>
                </div>
                <div class="col-md-3">
                    <strong>Fecha Generación:</strong> <span id="contexto-fecha">-</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Resumen Ejecutivo -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-speedometer2 me-2"></i>Resumen Ejecutivo
            </h5>
        </div>
        <div class="card-body">
            <div class="row g-4">
                <!-- Total Ingresos -->
                <div class="col-md-6 col-lg-3">
                    <div class="card border-success h-100">
                        <div class="card-body text-center">
                            <h6 class="text-success mb-2">Total Ingresos</h6>
                            <h3 class="mb-1" id="total-ingresos">$0</h3>
                            <div id="variacion-ingresos" class="small mt-2">
                                <!-- Variación se insertará aquí -->
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Total Egresos -->
                <div class="col-md-6 col-lg-3">
                    <div class="card border-danger h-100">
                        <div class="card-body text-center">
                            <h6 class="text-danger mb-2">Total Egresos</h6>
                            <h3 class="mb-1" id="total-egresos">$0</h3>
                            <div id="variacion-egresos" class="small mt-2">
                                <!-- Variación se insertará aquí -->
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Utilidad Neta -->
                <div class="col-md-6 col-lg-3">
                    <div class="card border-primary h-100">
                        <div class="card-body text-center">
                            <h6 class="text-primary mb-2">Ganancia Neta</h6>
                            <h3 class="mb-1" id="utilidad-neta">$0</h3>
                            <div id="variacion-utilidad" class="small mt-2">
                                <!-- Variación se insertará aquí -->
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Saldo Final de Caja -->
                <div class="col-md-6 col-lg-3">
                    <div class="card border-info h-100">
                        <div class="card-body text-center">
                            <h6 class="text-info mb-2">Dinero en Caja</h6>
                            <h3 class="mb-1" id="saldo-caja">$0</h3>
                            <div id="variacion-caja" class="small mt-2">
                                <!-- Variación se insertará aquí -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Indicadores Clave -->
    <div class="card mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0"> ¿Cómo va el negocio?</h5>
        </div>
        <div class="card-body">
            <div class="row text-center">
                <div class="col-md-3">
                    <div class="p-3">
                        <h6 class="text-muted">Ganancia por cada Bs 100 vendidos</h6>
                        <h4 class="text-success" id="margen-neto">31.7%</h4>
                        <small class="text-muted">Bueno</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3">
                        <h6 class="text-muted">Rendimiento del dinero</h6>
                        <h4 class="text-primary" id="rentabilidad">85.6%</h4>
                        <small class="text-muted">Excelente</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3">
                        <h6 class="text-muted">Por cada Bs 100 gastado, ganas</h6>
                        <h4 class="text-info" id="eficiencia">146.5%</h4>
                        <small class="text-muted">Muy eficiente</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3">
                        <h6 class="text-muted">¿Mejorando o empeorando?</h6>
                        <h4 class="text-center" id="tendencia-general">
                            <!-- Icono de tendencia se insertará aquí -->
                        </h4>
                        <small class="text-muted">vs mes anterior</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Loading -->
<div id="loading-container" style="display: none;" class="text-center py-5">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Cargando...</span>
    </div>
    <p class="mt-2">Generando resumen ejecutivo...</p>
</div>

<!-- JavaScript -->
<script src="/js/reportes/resumen-ejecutivo.js"></script>
