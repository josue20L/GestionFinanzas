<script>
// Función para actualizar la tabla con datos de consolidación
function actualizarTablaConsolidacion(datos) {
    if (!datos || !datos.periodos || !Array.isArray(datos.periodos)) {
        console.error('Datos de consolidación no válidos');
        return;
    }

    const tabla = document.getElementById('tabla-consolidado');
    const thead = tabla.querySelector('thead tr');
    const tbody = tabla.querySelector('tbody');

    // Limpiar columnas de períodos existentes (excepto Concepto y Total)
    while (thead.children.length > 2) {
        thead.removeChild(thead.children[1]);
    }

    // Agregar columnas para cada período
    datos.periodos.forEach((periodo, index) => {
        const th = document.createElement('th');
        th.className = 'text-center';
        th.textContent = periodo;
        thead.insertBefore(th, thead.lastElementChild);
    });

    // Actualizar cada fila con los valores por período
    const filas = tbody.querySelectorAll('tr');
    filas.forEach((fila, filaIndex) => {
        // Limpiar celdas de períodos existentes
        while (fila.children.length > 2) {
            fila.removeChild(fila.children[1]);
        }

        // Agregar celdas para cada período
        datos.periodos.forEach((periodo, periodoIndex) => {
            const td = document.createElement('td');
            td.className = 'text-end';
            
            // Obtener el valor según la fila
            const valor = obtenerValorPorFila(filaIndex, periodoIndex, datos);
            td.setAttribute('data-valor-bob', valor);
            td.textContent = formatNumber(valor);
            
            fila.insertBefore(td, fila.lastElementChild);
        });
    });

    // Actualizar totales
    actualizarTotales(datos);

    // Notificar al CurrencyManager para que aplique la moneda actual
    if (window.CurrencyManager) {
        window.CurrencyManager.actualizarValoresEnTablas();
    }
}

// Función para obtener el valor según la fila y período
function obtenerValorPorFila(filaIndex, periodoIndex, datos) {
    const valores = {
        0: datos.ventasNetas?.[periodoIndex] || 0,  // Ventas Netas
        1: datos.costoVentas?.[periodoIndex] || 0,  // Costo de Ventas
        2: (datos.ventasNetas?.[periodoIndex] || 0) - (datos.costoVentas?.[periodoIndex] || 0),  // Utilidad Bruta
        3: datos.gastoAdministrativo?.[periodoIndex] || 0,  // Gasto Administrativo
        4: datos.gastoComercializacion?.[periodoIndex] || 0,  // Gasto Comercialización
        5: datos.gastoSig?.[periodoIndex] || 0,  // Gasto SIG
        6: (datos.gastoAdministrativo?.[periodoIndex] || 0) + (datos.gastoComercializacion?.[periodoIndex] || 0) + (datos.gastoSig?.[periodoIndex] || 0),  // Gasto Operativo
        7: datos.ebit?.[periodoIndex] || 0,  // EBIT
        8: datos.gastoTributario?.[periodoIndex] || 0,  // Gasto Tributario
        9: datos.gastoFinanciero?.[periodoIndex] || 0,  // Gasto Financiero
        10: (datos.ebit?.[periodoIndex] || 0) - (datos.gastoTributario?.[periodoIndex] || 0) - (datos.gastoFinanciero?.[periodoIndex] || 0),  // Utilidad Después de Impuestos
        11: datos.otrosIngresos?.[periodoIndex] || 0,  // Otros Ingresos
        12: datos.otrosEgresos?.[periodoIndex] || 0,  // Otros Egresos
        13: ((datos.ebit?.[periodoIndex] || 0) - (datos.gastoTributario?.[periodoIndex] || 0) - (datos.gastoFinanciero?.[periodoIndex] || 0)) + (datos.otrosIngresos?.[periodoIndex] || 0) - (datos.otrosEgresos?.[periodoIndex] || 0)  // Utilidad Neta
    };
    
    return valores[filaIndex] || 0;
}

// Función para actualizar los totales
function actualizarTotales(datos) {
    // Calcular totales
    const totalVentasNetas = datos.ventasNetas?.reduce((a, b) => a + b, 0) || 0;
    const totalCostoVentas = datos.costoVentas?.reduce((a, b) => a + b, 0) || 0;
    const totalUtilidadBruta = totalVentasNetas - totalCostoVentas;
    const totalGastoAdministrativo = datos.gastoAdministrativo?.reduce((a, b) => a + b, 0) || 0;
    const totalGastoComercializacion = datos.gastoComercializacion?.reduce((a, b) => a + b, 0) || 0;
    const totalGastoSig = datos.gastoSig?.reduce((a, b) => a + b, 0) || 0;
    const totalGastoOperativo = totalGastoAdministrativo + totalGastoComercializacion + totalGastoSig;
    const totalEbit = datos.ebit?.reduce((a, b) => a + b, 0) || 0;
    const totalGastoTributario = datos.gastoTributario?.reduce((a, b) => a + b, 0) || 0;
    const totalGastoFinanciero = datos.gastoFinanciero?.reduce((a, b) => a + b, 0) || 0;
    const totalUtilidadDespuesImpuestos = totalEbit - totalGastoTributario - totalGastoFinanciero;
    const totalOtrosIngresos = datos.otrosIngresos?.reduce((a, b) => a + b, 0) || 0;
    const totalOtrosEgresos = datos.otrosEgresos?.reduce((a, b) => a + b, 0) || 0;
    const totalUtilidadNeta = totalUtilidadDespuesImpuestos + totalOtrosIngresos - totalOtrosEgresos;

    // Actualizar celdas de totales
    const elemVentas = document.getElementById('total-ventas-netas');
    elemVentas.setAttribute('data-valor-bob', totalVentasNetas);
    elemVentas.textContent = formatNumber(totalVentasNetas);

    const elemCosto = document.getElementById('total-costo-ventas');
    elemCosto.setAttribute('data-valor-bob', totalCostoVentas);
    elemCosto.textContent = formatNumber(totalCostoVentas);

    const elemUtilidadBruta = document.getElementById('total-utilidad-bruta');
    elemUtilidadBruta.setAttribute('data-valor-bob', totalUtilidadBruta);
    elemUtilidadBruta.textContent = formatNumber(totalUtilidadBruta);

    const elemGastoAdmin = document.getElementById('total-gasto-administrativo');
    elemGastoAdmin.setAttribute('data-valor-bob', totalGastoAdministrativo);
    elemGastoAdmin.textContent = formatNumber(totalGastoAdministrativo);

    const elemGastoComer = document.getElementById('total-gasto-comercializacion');
    elemGastoComer.setAttribute('data-valor-bob', totalGastoComercializacion);
    elemGastoComer.textContent = formatNumber(totalGastoComercializacion);

    const elemGastoSig = document.getElementById('total-gasto-sig');
    elemGastoSig.setAttribute('data-valor-bob', totalGastoSig);
    elemGastoSig.textContent = formatNumber(totalGastoSig);

    const elemGastoOperativo = document.getElementById('total-gasto-operativo');
    elemGastoOperativo.setAttribute('data-valor-bob', totalGastoOperativo);
    elemGastoOperativo.textContent = formatNumber(totalGastoOperativo);

    const elemEbit = document.getElementById('total-ebit');
    elemEbit.setAttribute('data-valor-bob', totalEbit);
    elemEbit.textContent = formatNumber(totalEbit);

    const elemGastoTrib = document.getElementById('total-gasto-tributario');
    elemGastoTrib.setAttribute('data-valor-bob', totalGastoTributario);
    elemGastoTrib.textContent = formatNumber(totalGastoTributario);

    const elemGastoFin = document.getElementById('total-gasto-financiero');
    elemGastoFin.setAttribute('data-valor-bob', totalGastoFinanciero);
    elemGastoFin.textContent = formatNumber(totalGastoFinanciero);

    const elemUtilDespImp = document.getElementById('total-utilidad-despues-impuestos');
    elemUtilDespImp.setAttribute('data-valor-bob', totalUtilidadDespuesImpuestos);
    elemUtilDespImp.textContent = formatNumber(totalUtilidadDespuesImpuestos);

    const elemOtrosIng = document.getElementById('total-otros-ingresos');
    elemOtrosIng.setAttribute('data-valor-bob', totalOtrosIngresos);
    elemOtrosIng.textContent = formatNumber(totalOtrosIngresos);

    const elemOtrosEgr = document.getElementById('total-otros-egresos');
    elemOtrosEgr.setAttribute('data-valor-bob', totalOtrosEgresos);
    elemOtrosEgr.textContent = formatNumber(totalOtrosEgresos);

    const elemUtilNeta = document.getElementById('total-utilidad-neta');
    elemUtilNeta.setAttribute('data-valor-bob', totalUtilidadNeta);
    elemUtilNeta.textContent = formatNumber(totalUtilidadNeta);
}

// Función para formatear números
const formatNumber = (typeof window !== 'undefined' && typeof window.formatNumber === 'function')
    ? window.formatNumber
    : function(num) {
        return new Intl.NumberFormat('en-US', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
            useGrouping: true
        }).format(num || 0);
    };

// Función para exportar a Excel (CSV simple) usando los últimos datos consolidados
function exportToExcel() {
    const dataWrapper = window.consolidacionDatosUltimos;
    const datos = dataWrapper && dataWrapper.datosPorPeriodo ? dataWrapper.datosPorPeriodo : null;
    if (!datos || !Array.isArray(datos.periodos) || !datos.periodos.length) {
        alert('No hay datos de consolidación para exportar.');
        return;
    }

    const periodos = datos.periodos;

    const conceptos = [
        'Ventas Netas',
        'Costo de Ventas',
        'Utilidad Bruta',
        'Gasto Administrativo',
        'Gasto Comercialización',
        'Gasto SIG',
        'Gasto Operativo',
        'EBIT',
        'Gasto Tributario',
        'Gasto Financiero',
        'Utilidad Después de Impuestos',
        'Otros Ingresos',
        'Otros Egresos',
        'Utilidad Neta'
    ];

    const filas = [];
    const encabezado = ['Concepto', ...periodos, 'Total'];
    filas.push(encabezado.join(','));

    for (let filaIndex = 0; filaIndex < conceptos.length; filaIndex++) {
        const row = [conceptos[filaIndex]];
        let totalFila = 0;

        periodos.forEach((_, periodoIndex) => {
            const valor = obtenerValorPorFila(filaIndex, periodoIndex, datos) || 0;
            totalFila += valor;
            row.push(String(valor).replace(/,/g, '.'));
        });

        row.push(String(totalFila).replace(/,/g, '.'));
        filas.push(row.join(','));
    }

    const csvContent = filas.join('\n');
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'consolidacion-estado-resultados.csv';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
}

