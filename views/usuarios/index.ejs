<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Usuarios</h2>
    <a class="btn btn-primary" href="/usuarios/nuevo">Nuevo Usuario</a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th>Activo</th>
                        <th>Accesos</th>
                        <th style="width: 180px;"></th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!usuarios || !usuarios.length) { %>
                        <tr>
                            <td colspan="5" class="text-center text-muted">No hay usuarios</td>
                        </tr>
                    <% } %>

                    <% (usuarios || []).forEach(({ user, accesos }) => { %>
                        <tr>
                            <td><%= user.NOMBRE_USUARIO %></td>
                            <td><%= user.EMAIL_USUARIO %></td>
                            <td>
                                <% if (user.ACTIVO) { %>
                                    <span class="badge bg-success">Sí</span>
                                <% } else { %>
                                    <span class="badge bg-secondary">No</span>
                                <% } %>
                            </td>
                            <td>
                                <% if (accesos && accesos.length) { %>
                                    <% const rolPrincipal = accesos[0].NOMBRE_ROL; %>
                                    <span class="badge bg-primary"><%= rolPrincipal %></span>
                                    <small class="text-muted d-block mt-1">
                                        <% const nombresEmpresas = accesos.map(a => a.NOMBRE_EMPRESA); %>
                                        <% if (nombresEmpresas.length <= 3) { %>
                                            Empresas: <%= nombresEmpresas.join(', ') %>
                                        <% } else { %>
                                            Empresas: <%= nombresEmpresas.slice(0, 3).join(', ') %><br>
                                            <%= nombresEmpresas.slice(3).join(', ') %>
                                        <% } %>
                                    </small>
                                <% } else { %>
                                    <span class="text-muted small">Sin accesos</span>
                                <% } %>
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" href="/usuarios/<%= user.ID_USUARIO %>/editar">Editar</a>
                                <button class="btn btn-sm btn-outline-danger btn-eliminar-usuario" data-id="<%= user.ID_USUARIO %>" data-nombre="<%= user.NOMBRE_USUARIO %>">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
// Manejar eliminación de usuarios con modal de confirmación
document.addEventListener('DOMContentLoaded', function() {
    const btnsEliminar = document.querySelectorAll('.btn-eliminar-usuario');
    const confirmModal = document.getElementById('confirmModal');
    const confirmModalTitle = document.getElementById('confirmModalTitle');
    const confirmModalMessage = document.getElementById('confirmModalMessage');
    const confirmModalOk = document.getElementById('confirmModalOk');
    let modalInstance = null;

    btnsEliminar.forEach(btn => {
        btn.addEventListener('click', function() {
            const idUsuario = this.getAttribute('data-id');
            const nombreUsuario = this.getAttribute('data-nombre');

            // Configurar el modal
            confirmModalTitle.textContent = 'Eliminar Usuario';
            confirmModalMessage.textContent = `¿Estás seguro de eliminar al usuario "${nombreUsuario}"? Esta acción no se puede deshacer.`;

            // Configurar botón de confirmación
            confirmModalOk.onclick = function() {
                // Crear y enviar formulario de eliminación
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/usuarios/${idUsuario}/eliminar`;
                document.body.appendChild(form);
                form.submit();
            };

            // Mostrar el modal
            if (!modalInstance) {
                modalInstance = new bootstrap.Modal(confirmModal);
            }
            modalInstance.show();
        });
    });
});
</script>
